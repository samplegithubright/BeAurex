{
  "name": "beaurex",
  "version": "1.0.0",
  "description": "BeAurex - Loyalty & Rewards Platform",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
